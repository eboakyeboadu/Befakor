rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    
    function isValidUser(data) {
      return data.email is string && data.email.size() <= 200
          && data.university is string && data.university.size() <= 200
          && data.dorm is string && data.dorm.size() <= 200
          && data.onboardingCompleted is bool
          && data.username is string && data.username.size() <= 100
          && data.fullName is string && data.fullName.size() <= 100
          && data.photoUrl is string && data.photoUrl.size() <= 1000
          && (!data.keys().contains('karmaEarned') || data.karmaEarned is int)
          && (!data.keys().contains('itemsRehomed') || data.itemsRehomed is int);
    }

    function isValidHandoff(data) {
      return data.itemId is string && data.itemId.size() <= 128
          && data.itemTitle is string && data.itemTitle.size() <= 200
          && data.sellerId is string && data.sellerId.size() <= 128
          && data.sellerEmail is string && data.sellerEmail.size() <= 200
          && data.buyerId is string && data.buyerId.size() <= 128
          && data.buyerEmail is string && data.buyerEmail.size() <= 200
          && data.rating is int && data.rating >= 1 && data.rating <= 5
          && data.points is int && data.points >= 10 && data.points <= 30
          && data.imageUrl is string && data.imageUrl.size() <= 1000
          && data.createdAt is int;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      
      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasAll(['email', 'username', 'fullName', 'photoUrl', 'university', 'dorm', 'onboardingCompleted', 'createdAt', 'updatedAt'])
                    && request.resource.data.size() == 9
                    && isValidUser(request.resource.data);
                    
      allow update: if (
                      isOwner(userId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['university', 'dorm', 'onboardingCompleted', 'username', 'fullName', 'photoUrl', 'updatedAt'])
                      && isValidUser(request.resource.data)
                    ) || (
                      // Increment Karma action: Any signed-in user can increment another user's karma/itemsRehomed
                      isSignedIn()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['karmaEarned', 'itemsRehomed', 'updatedAt'])
                      && isValidUser(request.resource.data)
                    );
    }

    match /listings/{listingId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() 
                    && request.resource.data.sellerId == request.auth.uid;
                    
      allow update: if isSignedIn() && (
        (resource.data.sellerId == request.auth.uid) ||
        (
          resource.data.status == "available"
          && request.resource.data.status == "sold"
          && request.resource.data.claimedBy == request.auth.uid
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedBy', 'claimedAt', 'claimRating', 'claimCollectorNote'])
        )
      );

      allow delete: if isSignedIn() 
                    && resource.data.sellerId == request.auth.uid;
    }

    match /handoffs/{handoffId} {
      allow read: if isSignedIn() && resource.data.sellerId == request.auth.uid;
      allow read: if isSignedIn() && resource.data.buyerId == request.auth.uid;
      
      allow create: if isSignedIn()
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.buyerId != request.resource.data.sellerId
                    && isValidHandoff(request.resource.data);
    }
  }
}
